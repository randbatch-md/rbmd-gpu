{
  "init_configuration": {

    "read_data": {
      "file": "Au_4k_v.data",
      "unit": "METAL",				 		//LJ ,METAL, REAL
      "atom_style": "atomic", 			//atomic，charge,full
      "velocity_type": "GAUSS"
    }

    //"inbuild": {
    //  "dims": [ 10, 10, 10 ],
    //  "x_range": [ 0.0, 10 ],
    //  "y_range": [ 0.0, 10 ],
    //  "z_range": [ 0.0, 10 ],
    //  "velocity_type": "GAUSS",
    //  "unit": "LJ"
    //}
  },

  "hyper_parameters": {
    "force_field": {
      "type": "EAM",					 //, OPLS-AA,CVFF,EAM(potential_file)
      "potential_file": "Au_u3.eam"
    },

    "neighbor": {
      "type": "VERLET", 				//RBL,VERLET-LIST
      "cut_off": 5.55,
      "r_core": 3.0,
      "neighbor_sample_num": 200,
	  "energy_rbl_flag": "yes"
    },

    "extend": {
    }
  },

  "execution": {
    "ensemble": "NVT", 							// "NVE","NVT" ,"NPT"
    "temperature":[ 298.0, 298.0, 0.1 ], //0.1 =100*dt
	"pressure" :[1.0,1.0,1000],
    "temp_ctrl_type": "NOSE_HOOVER", 				//BERENDSEN ，NOSE_HOOVER  
    "press_ctrl_type": "NOSE_HOOVER", 				//Berendsen ,NOSE_HOOVER
    "timestep": 1e-03,
    "num_steps": 10000			 //run 
  },

  "outputs": {

    "thermo_out": { 
      "interval": 1
    },

    "rdf_out": {
      "interval": 1,
      "radius": 5.55,
      "dr": 0.01,
      "statistics_rdf_steps": 1000,
      "atoms_pair": [[ 0, 0 ]]
    },
    
    "msd_out": {
      "interval": 10,
      "start_step": 0,
      "end_step": 10000
    },
    
    "vacf_out": {
      "interval": 10,
      "start_step": 0,
      "end_step": 10000
    },
    
    "trajectory_out": {
      "interval": 100
    }

  }
}